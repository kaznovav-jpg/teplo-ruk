rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reservations/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /orders/{id} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Заявку может создать и читать только сам пользователь; проверять и менять статус может администратор.
    match /masterApplications/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == uid
          && resource.data.status in ['rejected', 'removed']
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Статус мастера устанавливается только администратором. Пользователь не может назначить себя мастером.
    match /masterProfiles/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
  }
}