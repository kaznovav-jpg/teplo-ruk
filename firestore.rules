rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked');
    }

    // Публичный каталог участников: только имя и UID, без email и контактных данных.
    match /publicProfiles/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if false;
    }

    // Личные переписки доступны только двум указанным участникам.
    match /conversations/{conversationId} {
      allow read: if isActiveUser()
        && request.auth.uid in resource.data.participants;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['participants', 'names', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 160;
      allow update: if isActiveUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 160;
      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return isActiveUser()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function canReceiveMessage() {
          let people = get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
          let recipientUid = people[0] == request.auth.uid ? people[1] : people[0];
          return isAdmin()
            || !exists(/databases/$(database)/documents/users/$(recipientUid)/blockedUsers/$(request.auth.uid));
        }
        allow read: if isParticipant();
        allow create: if isParticipant() && canReceiveMessage()
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }
    }
    // Жалобы: пользователь может отправить жалобу только на участника своей переписки; читать их может только администратор.
    match /messageReports/{reportId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'reportedUid', 'conversationId',
          'messageId', 'messageText', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.conversationId is string
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
        && request.resource.data.reportedUid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
        && request.resource.data.messageId is string
        && request.resource.data.messageText is string
        && request.resource.data.messageText.size() <= 2000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !('status' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'addr', 'points', 'coupons',
          'cart', 'wish', 'follows', 'enrolled', 'progress', 'notes',
          'reservations', 'likes'
        ]);
      allow delete: if false;
    }

    // Список заблокированных собеседников видит и меняет только владелец аккаунта.
    match /users/{uid}/blockedUsers/{blockedUid} {
      allow read: if isActiveUser() && request.auth.uid == uid;
      allow create: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == blockedUid
        && request.resource.data.name is string
        && !exists(/databases/$(database)/documents/admins/$(blockedUid));
      allow delete: if isActiveUser() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/admins/$(blockedUid));
      allow update: if false;
    }
    match /userNotifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.uid == request.auth.uid;
      allow update: if isActiveUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /admins/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /classes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /classReviews/{reviewId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isActiveUser() && resource.data.uid == request.auth.uid;
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artists/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artistCollections/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reservations/{id} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      // Все новые заказы создаются только через защищённый серверный API,
      // который атомарно проверяет и уменьшает остатки товаров.
      allow create: if false;
      allow update: if (
        isAdmin()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paidAt'])
            && request.resource.data.paymentStatus == 'paid'
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfillmentStatus', 'fulfillmentUpdatedAt'])
            && request.resource.data.fulfillmentStatus in ['preparing', 'shipped', 'delivered']
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationRequest', 'orderStatus', 'cancellationReviewedAt'])
            && resource.data.cancellationRequest.status == 'pending'
            && request.resource.data.cancellationRequest.status in ['approved', 'rejected']
            && (
              (request.resource.data.cancellationRequest.status == 'approved' && request.resource.data.orderStatus == 'cancelled')
              || request.resource.data.cancellationRequest.status == 'rejected'
            )
          )
        )
      ) || (
        isActiveUser()
        && resource.data.uid == request.auth.uid
        && (!('fulfillmentStatus' in resource.data)
          || !(resource.data.fulfillmentStatus in ['shipped', 'delivered']))
        && (!('orderStatus' in resource.data) || resource.data.orderStatus != 'cancelled')
        && !('cancellationRequest' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationRequest'])
        && request.resource.data.cancellationRequest.status == 'pending'
        && request.resource.data.cancellationRequest.requesterUid == request.auth.uid
        && request.resource.data.cancellationRequest.reason is string
        && request.resource.data.cancellationRequest.reason.size() > 0
      );
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isActiveUser() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin()
        || (isActiveUser() && resource.data.uid == request.auth.uid);
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isActiveUser()
        && resource.data.uid == request.auth.uid;
    }

    // Заявку может создать и читать только сам пользователь; проверять и менять статус может администратор.
    // Индивидуальные заказы: отправка доступна посетителям, чтение и изменение — только администратору.
    match /customOrders/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'details', 'status', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.at is string;
      allow read, update, delete: if isAdmin();
    }

    match /masterApplications/{uid} {
      allow create: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow get: if isAdmin()
        || (isActiveUser() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow update: if isAdmin()
        || (isActiveUser()
          && request.auth.uid == uid
          && resource.data.status in ['rejected', 'removed']
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Работы мастеров: публично видны только одобренные; мастер управляет только своими заявками.
    match /artistWorks/{workId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || (isActiveUser() && resource.data.artistUid == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.artistUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/masterProfiles/$(request.auth.uid));
      allow update: if isAdmin()
        || (isActiveUser()
          && resource.data.artistUid == request.auth.uid
          && exists(/databases/$(database)/documents/masterProfiles/$(request.auth.uid))
          && request.resource.data.artistUid == resource.data.artistUid
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin()
        || (isActiveUser()
          && resource.data.artistUid == request.auth.uid
          && exists(/databases/$(database)/documents/masterProfiles/$(request.auth.uid)));
    }

    // Статус мастера устанавливается только администратором. Пользователь не может назначить себя мастером.
    match /masterProfiles/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
